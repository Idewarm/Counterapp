# PostgreSQL connection string
DATABASE_URL="postgresql://nano:nano@localhost:5432/nano_banana?schema=public"

# OpenAI — leave empty to run in offline "mock AI" mode (deterministic sample output)
OPENAI_API_KEY=""
# Multimodal model used for brand extraction, chat and content generation
OPENAI_MODEL="gpt-4o"
# Force mock AI even when a key is present ("1" to enable)
AI_MOCK=""

# Where uploaded logos are stored on disk (served via /api/uploads/*)
UPLOAD_DIR="./uploads"
# Max upload size in megabytes
MAX_UPLOAD_MB="5"
